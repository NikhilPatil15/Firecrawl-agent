# Required
FIRECRAWL_API_KEY=

# Model selection (default: Google Gemini)
MODEL_PROVIDER=google
MODEL_ID=gemini-2.5-pro-preview-05-06

# Provider API keys (users can override via BYOK in the UI)
# ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# AI_GATEWAY_API_KEY=
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_BASE_URL=

# Auth (NextAuth v5 / Auth.js) — required for Google sign-in
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Get a Google OAuth Client ID/Secret at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set this in production deployments (e.g. https://shopsmart.example.com)
# AUTH_TRUST_HOST=true
# NEXTAUTH_URL=http://localhost:3000

# Supabase — chat history (server-side only; service role bypasses RLS).
# Dashboard → Project Settings → API. Run supabase/schema.sql once in the SQL editor.
# Without these, the app works fine but chats aren't saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
